# ============================================================
# CSEDU Digital Knowledge Platform — Production Environment
# Used by docker-compose.prod.yml on the Azure VM (ip-lab-student-03).
# ONLY host port 8080 is exposed; all internal services communicate
# over the private Docker network using their service names below.
# Copy to .env on the server and fill in real secrets.
# NEVER commit the real .env file to git.
# ============================================================

# ============================================================
# DATABASE (PostgreSQL with pgvector)
# Internal host is the Docker service name `postgres`.
# No external port — debug via `docker compose exec postgres psql ...`.
# ============================================================
DB_USER=csedu_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=csedu_platform
DB_HOST=postgres
DB_PORT=5432

# ============================================================
# REDIS (Caching & Queue)
# No external port — debug via `docker compose exec redis redis-cli`.
# ============================================================
REDIS_URL=redis://redis:6379

# ============================================================
# MINIO (S3-Compatible Object Storage)
# No external port — debug via `docker compose exec minio mc ...`.
# ============================================================
MINIO_USER=minioadmin
MINIO_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
MINIO_BUCKET=csedu-files
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false

# ============================================================
# JWT AUTHENTICATION — MUST be a strong random string (32+ chars)
# Generate with: openssl rand -hex 32
# ============================================================
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRY_HOURS=1
REFRESH_EXPIRY_DAYS=7

# ============================================================
# Fine calculation (BDT)
# ============================================================
FINE_RATE_BDT_PER_DAY=50.0
MAX_FINE_PER_LOAN_BDT=500.0
FINE_CALC_INTERVAL=24h
FINE_BLOCK_THRESHOLD_BDT=50.0
LOAN_PERIOD_DAYS=14

# ============================================================
# LLM PROVIDERS
# ============================================================
GROQ_API_KEY=PUT_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL_SIMPLE=llama-3.1-8b-instant
GROQ_MODEL_LONG=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL_COMPLEX=openai/gpt-oss-120b
GROQ_TIMEOUT=30

GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE

# ============================================================
# SMTP Email (Brevo Free - 300 emails/day)
# Get credentials from: https://app.brevo.com/settings/keys/smtp
# Leave SMTP_HOST empty to disable email notifications
# ============================================================
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=YOUR_BREVO_SMTP_LOGIN        # e.g. b2630a001@smtp-brevo.com (Brevo SMTP login, NOT your account email)
SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY
# SMTP_FROM must be a Brevo-AUTHENTICATED sender or mail is accepted then silently
# not delivered (0% delivered, no bounce). Unauthenticated domains (cs.du.ac.bd) and
# free webmail (gmail/yahoo) fail DMARC. Simplest working sender = your account's
# auto-authenticated Brevo domain: <name>@<accountId>.brevosend.com
SMTP_FROM=CSEDU Platform <YOUR_NAME@YOUR_ACCOUNT_ID.brevosend.com>

GEMINI_MODEL=gemini-2.0-flash-exp

# ============================================================
# RAG Service Configuration (internal Docker network)
# ============================================================
RAG_SERVICE_URL=http://rag:8001
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=768
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=10
VECTOR_SEARCH_LIMIT=8
FTS_SEARCH_LIMIT=8

# ============================================================
# Query Configuration
# ============================================================
MAX_QUERY_LENGTH=5000
MIN_QUERY_LENGTH=3
MAX_CONTEXT_WINDOW=10

# ============================================================
# SSO Configuration (Optional — leave blank if not used)
# ============================================================
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://devops.farefin.com/api/v1/auth/sso/callback
SSO_PROVIDER_URL=

# ------------------------------------------------------------
# Google OAuth 2.0 sign-in (SDD Flow 4)
# Create credentials at https://console.cloud.google.com/apis/credentials
#   - Authorized redirect URI must EXACTLY match GOOGLE_REDIRECT_URI below
#   - Leave GOOGLE_CLIENT_ID blank to disable the "Continue with Google" button
# FRONTEND_URL is where users land after login. Leave blank for same-origin
# (recommended when the app and API share the devops.farefin.com host).
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://devops.farefin.com/api/v1/auth/google/callback
FRONTEND_URL=

# ============================================================
# Next.js public vars (exposed to browser)
# Browser fetches the API through Nginx on host port 8080.
# ============================================================
NEXT_PUBLIC_API_URL=/api/v1

# ============================================================
# App
# ============================================================
APP_ENV=production
PORT=8080